# Server
APP_PORT=8080
APP_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hsk_vinh?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
 
# Redis (Caching)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=168h

# Rate Limit
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

#Cloudinary 
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

#PayOS
PAY_OS_CLIENT_ID=dien-key-bi-mat
PAY_OS_API_KEY=dien-key-bi-mat
PAY_OS_CHECKSUM_KEY=dien-key-bi-mat

#Ngrok
NGROK_AUTHTOKEN=dien-key-bi-mat
NGROK_DOMAIN=dien-domain.ngrok-free.dev

#Google Cloud Vision API
# Path to Google Cloud service account JSON key file (relative to project root)
# This file should be placed in the secrets/ directory
GOOGLE_CLOUD_CREDENTIALS_PATH=secrets/warm-scout-470807-e3-9c64be6a950d.json

# Google Gemini AI / CCCD OCR Service (internal/cccd)
# API key from https://aistudio.google.com/apikey. Leave empty to disable OCR (endpoints return errorCode=20).
GEMINI_API_KEY=
# Gemini model used for structured ID card extraction
GEMINI_MODEL=gemini-3-flash-preview
# Per-call timeout in seconds for the Gemini REST API (default 45)
GEMINI_TIMEOUT_S=45
# Number of concurrent OCR workers / max in-flight Gemini calls (default 4)
CCCD_MAX_CONCURRENCY=4
